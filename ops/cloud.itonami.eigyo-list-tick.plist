<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  cloud.itonami.eigyo-list-tick — 1 日ぶんの収集と、3 表の載せ直し。

  1 日 1 回、いちばん古い 12 区画だけを引き直す（127 区画なので再訪は約 11 日）。
  毎日 48 区画を舐めない理由と、exit 2 の扱いは bin/resident.cljk の docstring に
  1 箇所だけ置いてある。**この plist に判断を書かない** —— launchctl は編集の
  たびに bootout/bootstrap が要るので、判断を持つ plist は誰も直さない。

  install:
    cp ops/cloud.itonami.eigyo-list-tick.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/cloud.itonami.eigyo-list-tick.plist
  watch:
    tail -40 /tmp/eigyo-list-tick.log
  stop:
    launchctl bootout gui/$(id -u)/cloud.itonami.eigyo-list-tick
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cloud.itonami.eigyo-list-tick</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/junkawasaki/github/com-junkawasaki/orgs/cloud-itonami/eigyo-list &amp;&amp; exec /opt/homebrew/bin/nbb --classpath src:../../kotoba-lang/org-openstreetmap-overpass/src bin/resident.cljk</string>
  </array>

  <!-- 05:40。fleet の朝の job（09:20 の loop-noren 等）と重ねない。 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>5</integer>
    <key>Minute</key><integer>40</integer>
  </dict>

  <!-- bootstrap は編集中に起こる。そこで 1 周走らせない。 -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/eigyo-list-tick.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/eigyo-list-tick.err</string>

  <!-- 12 区画 8 分 + 全行の commit 5 分。30 分を超えたら何かおかしい。 -->
  <key>ExitTimeOut</key>
  <integer>1800</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
